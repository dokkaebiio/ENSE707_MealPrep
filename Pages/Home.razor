@page "/"
@inject HttpClient Http

<PageTitle>Grocery Cart & Budget Planner</PageTitle>

<div class="top-nav">
    <span class="nav-badge">MealPlan</span>
    <nav class="nav-links">
        <!-- buttons/links go here -->
    </nav>
</div>

<div class="page-layout">

    <div class="main-content">
        <div class="search-row">
            <input type="text" placeholder="Search items..." class="search-box" @bind="SearchText" 
            @bind:event="oninput" />
<select class="category-select" @bind="SelectedCategory">
    <option value="All">All</option>
    @foreach (var cat in AllItems.Select(i => i.Category).Distinct().OrderBy(c => c))
    {
        <option value="@cat">@cat</option>
    }
</select>   
            <input type="button" value="Search" class="search-button" />
        </div>

        <div class="Search-results">
            @foreach (var item in FilteredItems)
            {
                <div class="item-card">
                    <div class="item-emoji">@item.Emoji</div>
                    <div class="item-name">@item.Name</div>
                    <div class="item-price">$@item.Price.ToString("F2") each</div>
                    <div class="item-actions">
                        <button class="qty-btn">−</button>
                        <div class="qty-display">1</div>
                        <button class="qty-btn">+</button>
                        <button class="add-btn">Add</button>
                    </div>
                </div>
            }
        </div>
    </div>

<aside class="sidebar">
    <div class="sidebar-card">

        <div class="budget-planner-section">
            <h2>Budget Planner</h2>
            <div class="budget-inputs">
                <label for="budget">Set your budget:</label>
                <input type="number" id="budget" placeholder="$0.00" />
                <button class="set-budget-btn">Set Budget</button>
            </div>
            <div class="budget-summary">
                <div class="budget-amount">Budget: $0.00</div>
            </div>
        </div>

        <hr class="sidebar-divider" />

<div class="cart-summary-section">
    <h2>Cart</h2>

    <div class="cart-items">
        <!-- Example cart item — you'll loop over real data later -->
        <div class="cart-item-row">
            <div class="item-emoji">🥛</div>
            <div class="cart-item-info">
                <div class="item-name">Milk (2L)</div>
                <div class="item-price">$4.30 each</div>
            </div>
            <div class="cart-item-qty">Qty: 1</div>
            <button class="remove-btn">✕</button>
        </div>

        <div class="cart-item-row">
            <div class="item-emoji">🍞</div>
            <div class="cart-item-info">
                <div class="item-name">Bread</div>
                <div class="item-price">$3.20 each</div>
            </div>
            <div class="cart-item-qty">Qty: 1</div>
            <button class="remove-btn">✕</button>
        </div>
    </div>

    <div class="cart-summary-total">
        Total: $7.50
    </div>
</div>

    </div>
</aside>

</div>

@code {
private List<GroceryItem> AllItems = new();

protected override async Task OnInitializedAsync()
{
    AllItems = await Http.GetFromJsonAsync<List<GroceryItem>>("data/items.json") ?? new();
}
private string SearchText = "";
private string SelectedCategory = "All";

private IEnumerable<GroceryItem> FilteredItems =>
    AllItems.Where(i =>
        (SelectedCategory == "All" || i.Category == SelectedCategory) &&
        (string.IsNullOrWhiteSpace(SearchText) || i.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase)));
}