@page "/"
@using MealPrep.Services
@inject HttpClient Http
@inject AuthService Auth
@inject SpendingHistoryService SpendingHistory
@inject ILocalStorageService LocalStorage

<PageTitle>Grocery Cart & Budget Planner</PageTitle>

<div class="top-nav">
    <span class="nav-badge">MealPlan</span>
    <nav class="nav-links">
            <div class="notif-wrapper">
                @if (DemoMode)
                {
                    <button class="demo-btn" @onclick="SimulateDealUpdate">Demo: new deal</button>
                    <button class="demo-btn" @onclick="ResetDealsDemo">Demo: reset</button>
                }
                <button class="notif-bell" aria-label="@BellLabel"
                        aria-expanded="@(ShowNotifications ? "true" : "false")"
                        @onclick="ToggleNotifications">
                    🔔
                    @if (UnseenDeals.Count > 0)
                    {
                        <span class="notif-count">@UnseenDeals.Count</span>
                    }
                </button>

                @if (ShowNotifications)
                {
                    <div class="notif-panel" role="region" aria-label="Deal notifications">
                        <div class="notif-header">
                            <strong>Deals</strong>
                            <button class="notif-mark-read" disabled="@(UnseenDeals.Count == 0)"
                                    @onclick="MarkDealsSeen">
                                Mark all as read
                            </button>
                        </div>

                        @if (!ActiveDeals.Any())
                        {
                            <div class="notif-empty">No deals right now.</div>
                        }

                        @foreach (var deal in ActiveDeals)
                        {
                            var item = AllItems.FirstOrDefault(i => i.Id == deal.ItemId);
                            if (item is null) { continue; }
                            var isNew = IsUnseen(deal);

                            <div class="notif-item @(isNew ? "notif-new" : "")">
                                <div class="notif-item-title">
                                    @item.Emoji @item.Name
                                    @if (isNew)
                                    {
                                        <span class="notif-tag">New</span>
                                    }
                                    @if (Cart.Any(c => c.Id == deal.ItemId))
                                    {
                                        <span class="notif-tag notif-tag-cart">In your cart</span>
                                    }
                                </div>
                                <div class="notif-item-detail">
                                    $@deal.DealPrice.ToString("F2") at @deal.Supermarket
                                    @if (RegularPrice(deal) is decimal was)
                                    {
                                        <span class="notif-was">$@was.ToString("F2")</span>
                                    }
                                </div>
                                <div class="notif-item-expiry">Ends @deal.ExpiresOn.ToString("ddd d MMM")</div>
                            </div>
                        }
                    </div>
                }
            </div>
        @if (Auth.CurrentUser is not null)
        {
            <span>Hi, @Auth.CurrentUser.Name</span>
            <button @onclick="HandleLogout">Logout</button>
        }
        else
        {
            <NavLink href="/login">Login</NavLink>
            <NavLink href="/signup">Sign Up</NavLink>
        }
    </nav>
</div>

<div class="page-layout">

    <div class="main-content">
        <div class="location-select-row">
            <label for="city">Your location:</label>
            <select id="city" @bind="SelectedCity">
                @foreach (var city in StoreBranches.Cities)
                {
                    <option value="@city">@city</option>
                }
            </select>
        </div>

        <div class="search-row">
            <input type="text" placeholder="Search items..." class="search-box"
                   @bind="SearchText" @bind:event="oninput" />
            <select class="category-select" @bind="SelectedCategory">
                <option value="All">All</option>
                @foreach (var cat in AllItems.Select(i => i.Category).Distinct().OrderBy(c => c))
                {
                    <option value="@cat">@cat</option>
                }
            </select>
            <input type="button" value="Search" class="search-button" />
        </div>

        <div class="Search-results">
            @if (!FilteredItems.Any())
            {
                <div class="empty-msg">No items found matching your search.</div>
            }
            else
            {
                @foreach (var item in FilteredItems)
                {
                    <div class="item-card">
                        <div class="item-emoji">@item.Emoji</div>
                        <div class="item-name">@item.Name</div>
                        <div class="item-price">
                            $@item.Price.ToString("F2") each
                            @if (item.HasPriceComparison)
                            {
                                <span class="cheapest-badge">@item.CheapestSupermarket</span>
                            }
                        </div>

                        @if (item.HasPriceComparison)
                        {
                            <button class="compare-link" @onclick="() => ToggleCompare(item.Id)">
                                @(IsComparing(item.Id) ? "Hide prices" : "Compare prices")
                            </button>

                            @if (IsComparing(item.Id))
                            {
                                <div class="price-comparison">
                                    @foreach (var p in item.Prices.OrderBy(p => p.Price))
                                    {
                                        <div class="price-comparison-row">
                                            <span>@p.Supermarket</span>
                                            <span>$@p.Price.ToString("F2")</span>
                                        </div>
                                    }
                                </div>
                            }
                        }

                            <div class="item-actions">
                                <button class="qty-btn" aria-label="Decrease quantity of @item.Name"
                                        disabled="@(GetQty(item.Id) <= 1)" @onclick="() => ChangeQty(item.Id, -1)">
                                    −
                                </button>
                                <input type="number" class="qty-input" min="1" max="99" inputmode="numeric"
                                       aria-label="Quantity of @item.Name"
                                       value="@GetQty(item.Id)"
                                       @onchange="e => SetQty(item.Id, e.Value?.ToString())" />
                                <button class="qty-btn" aria-label="Increase quantity of @item.Name"
                                        @onclick="() => ChangeQty(item.Id, 1)">
                                    +
                                </button>
                                <button class="add-btn" @onclick="() => AddToCart(item)">Add</button>
                            </div>
                    </div>
                }
            }
        </div>
    </div>

    <aside class="sidebar">
        <div class="sidebar-card">

            <!-- Budget planner -->
            <div class="budget-planner-section">
                <h2>Budget Planner</h2>

                <div class="budget-inputs">
                    <label for="budget">Set your budget:</label>
                    <input type="number" id="budget" placeholder="$0.00"
                           @bind="BudgetInput" @bind:event="oninput" />
                    <button class="set-budget-btn" @onclick="ApplyBudget">Set Budget</button>
                </div>

                @if (Auth.CurrentUser is not null && SuggestedBudget.HasValue)
                {
                    <div class="suggested-card">
                        <div class="suggested-label">Suggested budget</div>
                        <div class="suggested-row">
                            <span class="suggested-amount">$@SuggestedBudget.Value.ToString("F2")</span>
                            <button class="use-suggestion-btn" @onclick="UseSuggestedBudget">Use Budget</button>
                        </div>
                        <div class="suggested-footer">
                            <span class="suggested-basis">
                                Based on your last @TripsUsed shopping @(TripsUsed == 1 ? "trip" : "trips")
                            </span>
                            <button class="reset-history-btn" @onclick="ConfirmResetHistory">Reset</button>
                        </div>
                    </div>
                }

                <div class="budget-summary">
                    <div class="budget-line">
                        <span class="budget-amount">
                            Budget: @(Budget.HasValue ? $"${Budget:F2}" : "—")
                        </span>
                        <span class="status-badge status-@BudgetStatusClass budget-status-label">
                            @BudgetStatusIcon @BudgetStatusText
                        </span>
                    </div>
                    @if (Budget.HasValue)
                    {
                        <div class="progress-track" role="progressbar"
                             aria-valuemin="0" aria-valuemax="100"
                             aria-valuenow="@ProgressWidth"
                             aria-label="@ProgressSummary" title="@ProgressSummary">
                            <div class="progress-fill budget-@BudgetStatusClass"
                                 style="width: @(ProgressWidth)%"></div>
                        </div>
                    }
                </div>
            </div>

            <hr class="sidebar-divider" />

            <!-- Cart -->
            <div class="cart-summary-section">
                <h2>Cart</h2>

                <div class="cart-items">
                    @foreach (var line in Cart)
                    {
                        <div class="cart-item-row">
                            <div class="cart-item-info">
                                <div class="item-name">@line.Name</div>
                                <div class="item-price">$@line.UnitPrice.ToString("F2") each</div>
                            </div>
                                <div class="cart-item-qty-controls">
                                    <button class="qty-btn" aria-label="Decrease quantity of @line.Name"
                                            disabled="@(line.Qty <= 1)" @onclick="() => DecreaseQty(line)">
                                        −
                                    </button>
                                    <span class="cart-item-qty"><span class="visually-hidden">Qty: </span>@line.Qty</span>
                                    <button class="qty-btn" aria-label="Increase quantity of @line.Name"
                                            @onclick="() => IncreaseQty(line)">
                                        +
                                    </button>
                                </div>
                            <button class="remove-btn" @onclick="() => RemoveFromCart(line)">✕</button>
                        </div>
                    }
                </div>

                <div class="cart-summary-total">
                    <div class="total-line total-line-main">
                        Total (incl. GST): $@RunningTotal.ToString("F2")
                    </div>
                    <div class="total-line total-line-sub">
                        Excl. GST: $@TotalExclGst.ToString("F2") &nbsp;·&nbsp; GST: $@GstAmount.ToString("F2")
                    </div>
                </div>

                @if (BranchTotals.Any())
                {
                    <div class="cart-supermarket-comparison">
                        <div class="cart-supermarket-comparison-title">Best store for this cart in @SelectedCity:</div>
                        @foreach (var (branch, total) in BranchTotals)
                        {
                            <div class="supermarket-total-row @(branch == BestOverallBranch ? "best-market" : "")">
                                <span>@branch.Name @(branch == BestOverallBranch ? "✅" : "")</span>
                                <span>$@total.ToString("F2")</span>
                            </div>
                        }
                    </div>
                }

                <button class="finish-shopping-btn"
                        disabled="@(!Cart.Any() || Auth.CurrentUser is null)"
                        @onclick="FinishShopping">
                    Finish Shopping
                </button>
                <button class="create-recipe-btn" disabled="@(!Cart.Any())" @onclick="OpenCreateRecipeModal">
                    Create Recipe from Cart
                </button>
            </div>

            <hr class="sidebar-divider" />

            <!-- Saved recipes -->
            <div class="recipes-section">
                <h2>Saved Recipes</h2>

                @if (!Recipes.Any())
                {
                    <div class="recipes-empty">No recipes saved yet.</div>
                }
                else
                {
                    <div class="recipe-list">
                        @foreach (var recipe in Recipes.OrderBy(r => r.Date))
                        {
                            <div class="recipe-card" @onclick="() => OpenEditRecipeModal(recipe)">
                                <div class="recipe-card-name">@recipe.Name</div>
                                <div class="recipe-card-date">
                                    @(recipe.Date.HasValue ? recipe.Date.Value.ToString("ddd, MMM d") : "No date set")
                                </div>
                                <div class="recipe-card-count">@recipe.Ingredients.Count item(s)</div>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>
    </aside>

</div>

@* Over-budget confirmation modal *@
    @if (PendingAction is not null)
    {
        <div class="modal-overlay">
            <div class="modal-box">
                <p>
                    Adding <strong>@PendingLabel</strong> will take you to
                    $@PendingTotalIfAdded.ToString("F2"), over your $@Budget?.ToString("F2") budget.
                </p>
            <div class="modal-actions">
                <button @onclick="ConfirmAddAnyway">Add anyway</button>
                <button @onclick="CancelPendingAdd">Cancel</button>
                <button @onclick="GoChangeBudget">Change budget</button>
            </div>
        </div>
    </div>
}

@* Recipe create/edit modal *@
@if (ShowRecipeModal)
{
    <div class="modal-overlay">
        <div class="modal-box recipe-modal-box">
            <h3>@(EditingRecipe is null ? "New Recipe" : "Edit Recipe")</h3>

            <div class="recipe-form-field">
                <label for="recipe-name">Recipe name</label>
                <input type="text" id="recipe-name" placeholder="e.g. Taco Night"
                       @bind="RecipeNameInput" @bind:event="oninput" />
            </div>

            <div class="recipe-form-field">
                <label for="recipe-date">Day to make it</label>
                <input type="date" id="recipe-date" @bind="RecipeDateInput" />
            </div>

            <div class="recipe-ingredients-preview">
                <label>Ingredients</label>
                <ul>
                    @{
                        var ingredientsToShow = EditingRecipe is null ? Cart : EditingRecipe.Ingredients;
                    }
                    @foreach (var line in ingredientsToShow)
                    {
                        <li>@line.Name (x@(line.Qty))</li>
                    }
                </ul>
            </div>

            @if (!string.IsNullOrEmpty(RecipeErrorMessage))
            {
                <div class="recipe-error">@RecipeErrorMessage</div>
            }

            <div class="modal-actions recipe-modal-actions">
                <button @onclick="SaveRecipe">@(EditingRecipe is null ? "Save Recipe" : "Save Changes")</button>
                @if (EditingRecipe is not null)
                {
                    <button @onclick="DuplicateRecipeToNewDay">Save on This Day Too</button>
                    <button class="danger-btn" @onclick="DeleteRecipe">Delete</button>
                }
                <button @onclick="CloseRecipeModal">Cancel</button>
            </div>
        </div>
    </div>
}
@if (ShowResetConfirm)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <p>Clear your shopping history? This removes all @SpendingHistoryList.Count recorded trip(s) and the suggested budget will disappear until you shop again.</p>
            <div class="modal-actions">
                <button @onclick="DoResetHistory">Yes, reset</button>
                <button @onclick="CancelResetHistory">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    // ---------- Items / search ----------

    private List<GroceryItem> AllItems = new();
    private string SearchText = "";
    private string SelectedCategory = "All";

    private IEnumerable<GroceryItem> FilteredItems =>
        AllItems.Where(i =>
            (SelectedCategory == "All" || i.Category == SelectedCategory) &&
            (string.IsNullOrWhiteSpace(SearchText) ||
             i.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase)));

    // Item ids whose supermarket price comparison is currently expanded.
    private HashSet<int> ExpandedComparisons = new();

    private bool IsComparing(int itemId) => ExpandedComparisons.Contains(itemId);

    private void ToggleCompare(int itemId)
    {
        if (!ExpandedComparisons.Add(itemId))
            ExpandedComparisons.Remove(itemId);
    }

    protected override async Task OnInitializedAsync()
    {
        AllItems = await Http.GetFromJsonAsync<List<GroceryItem>>("data/items.json") ?? new();
        await LoadDealsAsync();
        await LoadSavedStateAsync();
        await LoadSpendingHistory();
    }

    // ---------- Deal notifications (FR4) ----------
    // Prototype scope: deals come from wwwroot/data/deals.json. "Updated" means a
    // deal's UpdatedAt is newer than the user's last "mark all as read".
    // No server, so nothing is pushed while the app is closed.

    private List<Deal> AllDeals = new();
    private DateTime? DealsLastSeen;
    private bool ShowNotifications;

    private List<Deal> ActiveDeals => DealNotifier.GetActiveDeals(AllDeals, DateTime.Now);
    private List<Deal> UnseenDeals => DealNotifier.GetUnseenDeals(AllDeals, DealsLastSeen, DateTime.Now);
    private bool IsUnseen(Deal deal) => UnseenDeals.Any(u => u.Id == deal.Id);

    private string BellLabel =>
        UnseenDeals.Count == 0 ? "Deal notifications" : $"Deal notifications, {UnseenDeals.Count} new";

    private decimal? RegularPrice(Deal deal) =>
        AllItems.FirstOrDefault(i => i.Id == deal.ItemId)
                ?.Prices?.FirstOrDefault(p => p.Supermarket == deal.Supermarket)?.Price;

    private void ToggleNotifications() => ShowNotifications = !ShowNotifications;

    private async Task MarkDealsSeen()
    {
        DealsLastSeen = DateTime.Now;
        await LocalStorage.SetItemAsync($"{KeyPrefix}_deals_seen", DealsLastSeen);
    }

    // ---------- For Demo and Presentation Use Only) ----------
    // Visit /?demo=true to show the demo buttons.
    // deals.json is untouched, and a page reload returns to the file's contents.        

    [Parameter, SupplyParameterFromQuery(Name = "demo")]
    public string? Demo { get; set; }

    private bool DemoMode => string.Equals(Demo, "true", StringComparison.OrdinalIgnoreCase);

    private readonly Random _demoRandom = new();

    // Demo-created deals are stored under a global key (not per-user), because deals
    // themselves aren't user-specific. Only demo deals go here; deals.json is never modified.
    private const string DemoDealsKey = "mealprep_demo_deals";

    private async Task LoadDealsAsync()
    {
        try
        {
            AllDeals = await Http.GetFromJsonAsync<List<Deal>>($"data/deals.json?v={DateTime.Now.Ticks}") ?? new();
        }
        catch (Exception ex) when (ex is HttpRequestException || ex is System.Text.Json.JsonException)
        {
            AllDeals = new();
        }

        // Deals added with the demo button survive reloads and also appear in normal
        // (non-demo) mode.
        var demoDeals = await LocalStorage.GetItemAsync<List<Deal>>(DemoDealsKey) ?? new();
        AllDeals.AddRange(demoDeals);
    }

    private async Task SimulateDealUpdate()
    {
        var candidates = AllItems
            .Where(i => i.Prices != null)
            .SelectMany(i => i.Prices.Select(p => (Item: i, Entry: p)))
            .Where(c => !AllDeals.Any(d => d.ItemId == c.Item.Id && d.Supermarket == c.Entry.Supermarket))
            .ToList();

        if (!candidates.Any())
            return;

        var pick = candidates
            .OrderByDescending(c => Cart.Any(l => l.Id == c.Item.Id))
            .ThenBy(_ => _demoRandom.Next())
            .First();

        var demoDeals = await LocalStorage.GetItemAsync<List<Deal>>(DemoDealsKey) ?? new();

        var newDeal = new Deal
        {
            Id = 1000 + demoDeals.Count + 1,   // demo ids start at 1000 so they can't clash with deals.json
            ItemId = pick.Item.Id,
            Supermarket = pick.Entry.Supermarket,
            DealPrice = Math.Round(pick.Entry.Price * 0.8m, 2),
            ExpiresOn = DateTime.Today.AddDays(7).AddHours(23).AddMinutes(59),
            UpdatedAt = DateTime.Now
        };

        demoDeals.Add(newDeal);
        await LocalStorage.SetItemAsync(DemoDealsKey, demoDeals);
        AllDeals.Add(newDeal);
    }

    // Clears the demo deals and the read state, so every deal in deals.json is New again.
    private async Task ResetDealsDemo()
    {
        DealsLastSeen = null;
        await LocalStorage.RemoveItemAsync($"{KeyPrefix}_deals_seen");
        await LocalStorage.RemoveItemAsync(DemoDealsKey);
        await LoadDealsAsync();
    }

    // ---------- Persistence (NFR4) ----------
    // Cart, budget and recipes are saved to local storage per user, with a
    // "guest" key when nobody is logged in.

    private string KeyPrefix => Auth.CurrentUser?.Email ?? "guest";

    private async Task LoadSavedStateAsync()
    {
        Cart = await LocalStorage.GetItemAsync<List<ListLineItem>>($"{KeyPrefix}_cart") ?? new();
        Recipes = await LocalStorage.GetItemAsync<List<Recipe>>($"{KeyPrefix}_recipes") ?? new();
        Budget = await LocalStorage.GetItemAsync<decimal?>($"{KeyPrefix}_budget");
        BudgetInput = Budget?.ToString() ?? "";
        DealsLastSeen = await LocalStorage.GetItemAsync<DateTime?>($"{KeyPrefix}_deals_seen");   // new

    }

    private async Task SaveCartAsync() => await LocalStorage.SetItemAsync($"{KeyPrefix}_cart", Cart);
    private async Task SaveRecipesAsync() => await LocalStorage.SetItemAsync($"{KeyPrefix}_recipes", Recipes);
    private async Task SaveBudgetAsync() => await LocalStorage.SetItemAsync($"{KeyPrefix}_budget", Budget);

    // ---------- Cart ----------

    private List<ListLineItem> Cart = new();
    private decimal RunningTotal => Cart.Sum(c => c.LineTotal);

    private const int MaxQty = 99;

    private async Task DoAdd(GroceryItem item, int qty = 1)
    {
        var existing = Cart.FirstOrDefault(c => c.Id == item.Id);
        if (existing is not null)
        {
            existing.Qty = Math.Min(existing.Qty + qty, MaxQty);
        }
        else
        {
            Cart.Add(new ListLineItem
            {
                Id = item.Id,
                Name = item.Name,
                UnitPrice = item.Price,
                Qty = qty,
                Prices = item.Prices
            });
        }
        await SaveCartAsync();
    }

    // --- GST (FR5) ---
    // NZ GST rate. Item prices are assumed GST-inclusive, matching standard NZ retail pricing.
    private const decimal GstRate = 0.15m;

    private decimal TotalExclGst => Math.Round(RunningTotal / (1 + GstRate), 2);
    private decimal GstAmount => Math.Round(RunningTotal - TotalExclGst, 2);

    // --- Whole-cart store comparison, per branch in the selected city (FR7) ---

    private string SelectedCity = StoreBranches.Cities.FirstOrDefault() ?? "Auckland";

    private List<(Branch Branch, decimal Total)> BranchTotals
    {
        get
        {
            var relevantBranches = StoreBranches.All.Where(b => b.City == SelectedCity).ToList();
            if (!Cart.Any() || !relevantBranches.Any())
                return new();

            var results = new List<(Branch, decimal)>();
            foreach (var branch in relevantBranches)
            {
                decimal total = 0m;
                foreach (var line in Cart)
                {
                    var priceAtBrand = line.Prices.FirstOrDefault(p => p.Supermarket == branch.Supermarket);
                    // Fallback: items without a price at this brand use their
                    // base/cheapest price instead — a reasonable estimate, not exact.
                    var basePrice = priceAtBrand?.Price ?? line.UnitPrice;
                    total += basePrice * branch.PriceModifier * line.Qty;
                }
                results.Add((branch, total));
            }

            return results.OrderBy(r => r.Item2).ToList();
        }
    }

    private Branch? BestOverallBranch => BranchTotals.FirstOrDefault().Branch;

    private async Task RemoveFromCart(ListLineItem line)
    {
        Cart.Remove(line);
        await SaveCartAsync();
    }

    // ---------- Budget ----------

    private decimal? Budget;
    private string BudgetInput = "";

    private async Task ApplyBudget()
    {
        if (decimal.TryParse(BudgetInput, out var val) && val > 0)
            Budget = val;
        else
            Budget = null; // empty/invalid input clears the budget — "no budget" is allowed
        await SaveBudgetAsync();
    }

    private decimal BudgetPercent => Budget.HasValue && Budget > 0
        ? (RunningTotal / Budget.Value) * 100m
        : 0;

    // The bar is driven by the cart total (RunningTotal) vs the budget, capped at 100% width.
    private string ProgressWidth => Math.Min(BudgetPercent, 100).ToString("F0");

    private string ProgressSummary =>
        Budget.HasValue
            ? $"${RunningTotal:F2} of ${Budget.Value:F2} ({BudgetPercent:F0}%)"
            : "";

    private string BudgetStatusClass =>
        Budget is null ? "none" :
        BudgetPercent > 100 ? "over" :
        BudgetPercent >= 100 ? "reached" :
        BudgetPercent >= 90 ? "danger" :
        BudgetPercent >= 75 ? "warning" :
        "good";

    private string BudgetStatusText =>
        Budget is null ? "No budget set" :
        BudgetPercent > 100 ? "Over budget!" :
        BudgetPercent >= 100 ? "Budget reached!" :
        BudgetPercent >= 90 ? "Almost at budget!" :
        BudgetPercent >= 75 ? "Getting close" :
        "Looking good";

    private string BudgetStatusIcon =>
        Budget is null ? "" :
        BudgetPercent > 100 ? "✕" :
        BudgetPercent >= 100 ? "!" :
        BudgetPercent >= 75 ? "⚠" :
        "✓";

    // ---------- Quantity selection and add-to-cart with over-budget prompt ----------

    // Quantity picked on each item card before adding (defaults to 1).
    private Dictionary<int, int> SelectedQty = new();

    private int GetQty(int itemId) => SelectedQty.TryGetValue(itemId, out var q) ? q : 1;

    private void ChangeQty(int itemId, int delta) => SelectedQty[itemId] = Math.Clamp(GetQty(itemId) + delta, 1, MaxQty);

    private void SetQty(int itemId, string? raw) => SelectedQty[itemId] = ParseQty(raw);

    // Turns whatever the user typed into a valid quantity:
    // blank or invalid -> 1, decimals round down, anything above MaxQty -> MaxQty.
    private static int ParseQty(string? raw)
    {
        if (!decimal.TryParse(raw, System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture, out var n))
            return 1;

        return (int)Math.Clamp(Math.Floor(n), 1, MaxQty);
    }

    // Waits for the user's answer to the over-budget prompt.
    private Func<Task>? PendingAction;
    private string PendingLabel = "";
    private decimal PendingTotalIfAdded;   // what the total would become

    // Everything that raises the total goes through here, so the budget check
    // applies equally to item-card adds and + presses in the cart.
    private async Task RunWithBudgetCheck(string label, decimal extraCost, Func<Task> action)
    {
        var wouldBeTotal = RunningTotal + extraCost;

        if (Budget.HasValue && wouldBeTotal > Budget.Value)
        {
            // ask users first
            PendingLabel = label;
            PendingTotalIfAdded = wouldBeTotal;
            PendingAction = action;
            return;
        }

        await action();
    }

    private async Task AddToCart(GroceryItem item)
    {
        var qty = GetQty(item.Id);
        var label = qty == 1 ? item.Name : $"{qty} × {item.Name}";

        await RunWithBudgetCheck(label, item.Price * qty, async () =>
        {
            await DoAdd(item, qty);
            SelectedQty.Remove(item.Id);   // back to 1 for the next add
        });
    }

    private async Task IncreaseQty(ListLineItem line)
    {
        if (line.Qty >= MaxQty)
            return;

        await RunWithBudgetCheck(line.Name, line.UnitPrice, async () =>
        {
            line.Qty++;
            await SaveCartAsync();
        });
    }

    private async Task DecreaseQty(ListLineItem line)
    {
        if (line.Qty <= 1)
            return;

        line.Qty--;
        await SaveCartAsync();
    }

    private async Task ConfirmAddAnyway()
    {
        var action = PendingAction;
        PendingAction = null;
        if (action is not null)
            await action();
    }

    private void CancelPendingAdd() => PendingAction = null;

    private void GoChangeBudget() => PendingAction = null;   // closes the modal so the user can edit the budget field


    // ---------- Spending history / suggested budget (FR3) ----------

    private const int SuggestionTripCount = 5;   // how many recent trips feed the suggestion

    private List<SpendingRecord> SpendingHistoryList = new();
    private decimal? SuggestedBudget;
    private int TripsUsed => Math.Min(SpendingHistoryList.Count, SuggestionTripCount);

    private async Task LoadSpendingHistory()
    {
        if (Auth.CurrentUser is null)
            return;

        SpendingHistoryList = await SpendingHistory.GetHistoryAsync(Auth.CurrentUser.Email);
        SuggestedBudget = SpendingHistory.GetSuggestedBudget(SpendingHistoryList, SuggestionTripCount);
    }

    private async Task UseSuggestedBudget()
    {
        if (SuggestedBudget.HasValue)
        {
            Budget = SuggestedBudget.Value;
            BudgetInput = SuggestedBudget.Value.ToString("F2");
            await SaveBudgetAsync();
        }
    }

    private async Task FinishShopping()
    {
        if (!Cart.Any() || Auth.CurrentUser is null)
            return;

        await SpendingHistory.LogTripAsync(Auth.CurrentUser.Email, RunningTotal);
        Cart.Clear();
        await SaveCartAsync();
        await LoadSpendingHistory(); // refresh the suggestion with the new trip included
    }

    // Resets the user's spending history and suggested budget. This is a destructive action, so we show a confirmation modal first.
    private bool ShowResetConfirm = false;

    private void ConfirmResetHistory()
    {
        ShowResetConfirm = true;
    }

    private void CancelResetHistory()
    {
        ShowResetConfirm = false;
    }

    private async Task DoResetHistory()
    {
        if (Auth.CurrentUser is not null)
        {
            await SpendingHistory.ClearHistoryAsync(Auth.CurrentUser.Email);
            await LoadSpendingHistory();
        }
        ShowResetConfirm = false;
    }

    // ---------- Recipes ----------

    private List<Recipe> Recipes = new();

    private bool ShowRecipeModal = false;
    private Recipe? EditingRecipe = null;   // null => creating a new recipe from the current cart
    private string RecipeNameInput = "";
    private DateTime? RecipeDateInput;
    private string RecipeErrorMessage = "";

    private void OpenCreateRecipeModal()
    {
        if (!Cart.Any())
            return;

        EditingRecipe = null;
        RecipeNameInput = "";
        RecipeDateInput = DateTime.Today;
        RecipeErrorMessage = "";
        ShowRecipeModal = true;
    }

    private void OpenEditRecipeModal(Recipe recipe)
    {
        EditingRecipe = recipe;
        RecipeNameInput = recipe.Name;
        RecipeDateInput = recipe.Date;
        RecipeErrorMessage = "";
        ShowRecipeModal = true;
    }

    private async Task SaveRecipe()
    {
        if (string.IsNullOrWhiteSpace(RecipeNameInput))
        {
            RecipeErrorMessage = "Please give the recipe a name.";
            return;
        }

        if (EditingRecipe is null)
        {
            // Creating a brand-new recipe from a snapshot of the current cart
            var newRecipe = new Recipe
            {
                Name = RecipeNameInput.Trim(),
                Date = RecipeDateInput,
                Ingredients = Cart.Select(c => new ListLineItem
                {
                    Id = c.Id,
                    Name = c.Name,
                    UnitPrice = c.UnitPrice,
                    Qty = c.Qty
                }).ToList()
            };

            Recipes.Add(newRecipe);
        }
        else
        {
            // Editing an existing, previously-saved recipe
            EditingRecipe.Name = RecipeNameInput.Trim();
            EditingRecipe.Date = RecipeDateInput;
        }

        await SaveRecipesAsync();
        CloseRecipeModal();
    }

    private async Task DuplicateRecipeToNewDay()
    {
        if (EditingRecipe is null)
            return;

        if (string.IsNullOrWhiteSpace(RecipeNameInput))
        {
            RecipeErrorMessage = "Please give the recipe a name.";
            return;
        }

        // Brand-new, independent recipe with the same ingredients, using the name/date
        // currently in the form — the original is left untouched.
        var copy = new Recipe
        {
            Name = RecipeNameInput.Trim(),
            Date = RecipeDateInput,
            Ingredients = EditingRecipe.Ingredients.Select(i => new ListLineItem
            {
                Id = i.Id,
                Name = i.Name,
                UnitPrice = i.UnitPrice,
                Qty = i.Qty
            }).ToList()
        };

        Recipes.Add(copy);
        await SaveRecipesAsync();
        CloseRecipeModal();
    }

    private async Task DeleteRecipe()
    {
        if (EditingRecipe is not null)
            Recipes.Remove(EditingRecipe);

        await SaveRecipesAsync();
        CloseRecipeModal();
    }

    private void CloseRecipeModal()
    {
        ShowRecipeModal = false;
        EditingRecipe = null;
        RecipeErrorMessage = "";
    }

    public class Recipe
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public string Name { get; set; } = "";
        public DateTime? Date { get; set; }
        public List<ListLineItem> Ingredients { get; set; } = new();
    }

    // ---------- Auth ----------

    private async Task HandleLogout()
    {
        await Auth.LogoutAsync();
        await LoadSavedStateAsync();   // show the guest's state, not the previous user's
    }
}
